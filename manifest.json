{
    "manifest_version":  3,
    "name":  "YT-ADX",
    "version":  "1.0.4",
    "description":  "Blocks YouTube\u0027s ad endpoints, strips ad breaks out of the player response, and clears ad surfaces from the page.",
    "minimum_chrome_version":  "111",
    "permissions":  [
                        "declarativeNetRequest",
                        "storage"
                    ],
    "host_permissions":  [
                             "*://*.youtube.com/*"
                         ],
    "background":  {
                       "service_worker":  "src/background.js"
                   },
    "action":  {
                   "default_popup":  "src/ui.html",
                   "default_title":  "YT-ADX",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "32":  "icons/icon32.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "options_ui":  {
                       "page":  "src/ui.html",
                       "open_in_tab":  true
                   },
    "declarative_net_request":  {
                                    "rule_resources":  [
                                                           {
                                                               "id":  "ads",
                                                               "enabled":  true,
                                                               "path":  "rules/ads.json"
                                                           }
                                                       ]
                                },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "*://*.youtube.com/*"
                                            ],
                                "js":  [
                                           "src/inject.js"
                                       ],
                                "world":  "MAIN",
                                "run_at":  "document_start",
                                "all_frames":  true
                            },
                            {
                                "matches":  [
                                                "*://*.youtube.com/*"
                                            ],
                                "js":  [
                                           "src/content.js"
                                       ],
                                "css":  [
                                            "src/content.css"
                                        ],
                                "run_at":  "document_start",
                                "all_frames":  false
                            }
                        ],
    "icons":  {
                  "16":  "icons/icon16.png",
                  "32":  "icons/icon32.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              }
}